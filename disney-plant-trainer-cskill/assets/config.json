{
  "version": "1.0.0",
  "name": "disney-plant-trainer",

  "api_sources": {
    "unsplash": {
      "enabled": true,
      "base_url": "https://api.unsplash.com",
      "rate_limit": 50
    },
    "pexels": {
      "enabled": true,
      "base_url": "https://api.pexels.com/v1",
      "rate_limit": 200
    },
    "pixabay": {
      "enabled": true,
      "base_url": "https://pixabay.com/api",
      "rate_limit": 100
    }
  },

  "scraping": {
    "max_images_per_query": 100,
    "max_pages": 10,
    "images_per_page": 30,
    "min_width": 800,
    "min_height": 600,
    "preferred_orientation": null,
    "color_filter": null,
    "safe_search": true
  },

  "download": {
    "max_concurrent": 5,
    "timeout_seconds": 30,
    "max_retries": 3,
    "retry_delay": 1.0,
    "backoff_multiplier": 2.0,
    "max_file_size_mb": 50.0,
    "verify_integrity": true,
    "validate_images": true
  },

  "processing": {
    "target_size": [512, 512],
    "resize_mode": "contain",
    "pad_color": [0, 0, 0],
    "normalize": true,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225],
    "output_format": "RGB",
    "quality": 95
  },

  "augmentation": {
    "enabled": true,
    "horizontal_flip": 0.5,
    "vertical_flip": 0.0,
    "rotation_range": [-15, 15],
    "rotation_prob": 0.3,
    "brightness_range": [0.8, 1.2],
    "brightness_prob": 0.3,
    "contrast_range": [0.8, 1.2],
    "contrast_prob": 0.3,
    "saturation_range": [0.8, 1.2],
    "saturation_prob": 0.3,
    "blur_prob": 0.1,
    "crop_prob": 0.3,
    "noise_prob": 0.1
  },

  "validation": {
    "min_width": 256,
    "min_height": 256,
    "max_width": 8192,
    "max_height": 8192,
    "max_file_size_mb": 50.0,
    "min_aspect_ratio": 0.25,
    "max_aspect_ratio": 4.0,
    "min_quality_score": 0.3,
    "allowed_formats": ["JPEG", "PNG", "WEBP", "GIF"],
    "require_color": true,
    "check_duplicates": true
  },

  "training": {
    "epochs": 50,
    "batch_size": 32,
    "learning_rate": 0.001,
    "validation_split": 0.15,
    "early_stopping_patience": 10,
    "checkpoint_frequency": 5,
    "input_size": [224, 224],
    "pretrained": true,
    "freeze_backbone": false,
    "optimizer": "adam",
    "scheduler": "cosine",
    "weight_decay": 0.0001,
    "dropout": 0.2,
    "mixed_precision": false
  },

  "rate_limiting": {
    "requests_per_second": 1.0,
    "min_delay_seconds": 0.5,
    "max_delay_seconds": 10.0,
    "max_concurrent_requests": 5,
    "backoff_multiplier": 2.0,
    "max_backoff_seconds": 300.0,
    "respect_robots_txt": true
  },

  "cache": {
    "enabled": true,
    "max_size_gb": 10.0,
    "default_ttl_days": 30
  },

  "disney_analysis": {
    "height_thresholds": {
      "ground_cover": 0.1,
      "low": 0.25,
      "medium": 0.5,
      "tall": 0.75,
      "canopy": 1.0
    },
    "principle_weights": {
      "forced_perspective": 0.2,
      "color_harmony": 0.15,
      "layering": 0.2,
      "focal_points": 0.15,
      "symmetry_balance": 0.1,
      "seasonal_rotation": 0.1,
      "maintenance_access": 0.1
    }
  },

  "plant_queries": {
    "common_species": [
      "rose", "tulip", "petunia", "marigold", "begonia",
      "impatiens", "geranium", "pansy", "dahlia", "zinnia",
      "boxwood", "holly", "azalea", "hydrangea", "camellia",
      "palm", "fern", "hosta", "lavender", "ornamental grass"
    ],
    "arrangement_types": [
      "flower_bed", "hedge_row", "tree_cluster", "ground_cover",
      "layered_planting", "focal_point", "disney_style",
      "formal_garden", "cottage_garden", "tropical_landscape"
    ]
  }
}
