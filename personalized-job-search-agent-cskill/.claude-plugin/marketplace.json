  "metadata": {
    "category": "career-automation",
    "subcategory": "job-search",
    "complexity": "high",
    "estimated_lines": 3500,
    "created_by": "agent-skill-creator",
    "architecture": "complex-skill",
    "agentdb_enabled": true,
    "learning_enabled": true,
    "privacy_focused": true,
    "data_encryption": true
  },
  "configuration": {
    "storage": {
      "user_profile": "assets/user_profile.json",
      "job_database": "assets/jobs_database.json",
      "applications": "assets/applications.json",
      "preferences": "assets/preferences.json"
    },
    "search_settings": {
      "max_results_per_search": 100,
      "search_frequency": "daily",
      "auto_apply": false,
      "notification_enabled": true
