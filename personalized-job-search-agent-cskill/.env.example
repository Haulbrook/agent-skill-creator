# API Keys for Job Search Agent
# Copy this file to .env and fill in your keys

# AI/ML APIs (for cover letters and analysis)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Job Board APIs
LINKEDIN_API_KEY=your_linkedin_key_here
INDEED_PUBLISHER_ID=your_indeed_id_here
GLASSDOOR_API_KEY=your_glassdoor_key_here

# Optional: Company Data APIs
CLEARBIT_API_KEY=your_clearbit_key_here
CRUNCHBASE_API_KEY=your_crunchbase_key_here
